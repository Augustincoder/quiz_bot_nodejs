# Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Optional: Supabase credentials
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key

# Optional: Redis connection URL
# REDIS_URL=redis://default:password@host:port

# Optional: Bot Administrator Telegram IDs (comma-separated for multiple admins)
# ADMIN_ID=123456789
# ADMIN_IDS=123456789,987654321

# Optional: Admin API key for web dashboard
# ADMIN_API_KEY=your-secure-random-admin-api-key

# Optional: Gemini AI API Key
# GEMINI_API_KEY=your-gemini-api-key

# Optional: Sentry DSN for error monitoring
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0


