# Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Optional: Supabase credentials
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key

# Optional: Redis connection URL
# REDIS_URL=redis://default:password@host:port

# Optional: Bot Administrator Telegram IDs (comma-separated for multiple admins)
# ADMIN_ID=123456789
# ADMIN_IDS=123456789,987654321

# Optional: Admin API key for web dashboard
# ADMIN_API_KEY=your-secure-random-admin-api-key

# Optional: Gemini AI API Key
# GEMINI_API_KEY=your-gemini-api-key

# Optional: Sentry DSN for error monitoring
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Telegram Channel ID for Timetable CDN image storage (e.g. -100xxxxxxxxxx)
# CHANNEL_ID=-1001234567890
# TIMETABLE_STORAGE_CHANNEL_ID=-1001234567890

# Optional: EduPage HTTPS/HTTP Outbound Proxy (if cloud server IP is geoblocked/rate-limited)
# Supports single or multiple comma-separated proxies: http://, https://
# EDUPAGE_PROXY_URL=http://user:pass@proxy-host:8080
# EDUPAGE_PROXIES=http://proxy1:8080,http://proxy2:8080

# Optional: EduPage Edge Mirror / Cloudflare Worker Reverse Proxy
# Completely bypasses datacenter IP blocks using Cloudflare edge network (see scripts/cloudflare-worker-edupage.js)
# EDUPAGE_BASE_URL=https://tsue-edupage-mirror.your-subdomain.workers.dev
